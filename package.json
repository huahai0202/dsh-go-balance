{
  "name": "local-balance",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huahai0202/dsh-go-balance.git"
  },
  "homepage": "https://github.com/huahai0202/dsh-go-balance#readme",
  "keywords": [
    "dsh",
    "dsh-go",
    "deepseek-harness",
    "jet-hub",
    "balance"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dshGo": {
    "v": 1,
    "capabilities": ["files"],
    "title": {
      "zh": "渠道余额",
      "en": "Channel balance"
    },
    "icon": "wallet",
    "contributes": {
      "composer.actions": [
        {
          "id": "open-balance",
          "label": {
            "zh": "渠道余额",
            "en": "Balance"
          },
          "icon": "wallet",
          "effect": {
            "type": "open",
            "page": "panel:balance"
          }
        }
      ],
      "panels": [
        {
          "id": "balance",
          "title": {
            "zh": "当前渠道余额",
            "en": "Channel balance"
          },
          "icon": "wallet",
          "placement": [
            "session.tab",
            "features",
            "plugin"
          ],
          "presentation": "sheet"
        },
        {
          "id": "manage",
          "title": {
            "zh": "管理",
            "en": "Manage"
          },
          "icon": "settings",
          "placement": [
            "plugin"
          ],
          "presentation": "sheet"
        },
        {
          "id": "channels",
          "title": {
            "zh": "选择渠道",
            "en": "Channels"
          },
          "icon": "list",
          "placement": [
            "plugin"
          ],
          "presentation": "sheet"
        }
      ]
    }
  },
  "description": "输入框上方的「渠道余额」胶囊：看余额、签到、切渠道、管账号，可查 ChatGPT/Codex 额度。"
}
